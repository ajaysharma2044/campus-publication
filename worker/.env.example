# Copy to .env (never commit .env). Values here are examples; nothing is a real secret.
CAMPUS_ENV=development                      # development | staging | production
CAMPUS_PUBLICATION_NAME="The Campus Ledger (working title)"
DATABASE_URL=postgresql://campus:campus_local_dev@localhost:5432/campus_research
TEST_DATABASE_URL=postgresql://campus:campus_local_dev@localhost:5432/campus_research_test

# Model provider (API-billed; separate from any Claude Code subscription). Leave unset = unconnected.
# ANTHROPIC_API_KEY=
# Role routing overrides (defaults in campus_worker/config.py)
# CAMPUS_MODEL_COORDINATOR_MODEL=claude-sonnet-5-5
# CAMPUS_MODEL_CLASSIFICATION_MODEL=claude-haiku-5-5
# CAMPUS_MODEL_EXTRACTION_MODEL=claude-sonnet-5-5
# CAMPUS_MODEL_WRITING_MODEL=claude-sonnet-5-5
# CAMPUS_MODEL_EDITORIAL_MODEL=claude-opus-5-5
# CAMPUS_MODEL_VERIFICATION_MODEL=claude-sonnet-5-5
# CAMPUS_MODEL_ESCALATION_MODEL=claude-opus-5-5

# Budget caps in minor units (cents). Defaults: $3/day, $60/month, 10% headroom.
CAMPUS_BUDGET_DAILY_MINOR=300
CAMPUS_BUDGET_MONTHLY_MINOR=6000
CAMPUS_BUDGET_HEADROOM_PCT=10

# Quotas and concurrency
CAMPUS_QUOTA_NEW_PAGES_PER_DAY=1
CAMPUS_QUOTA_UPDATES_PER_DAY=5
CAMPUS_MAX_CONCURRENT_MODEL_TASKS=2
CAMPUS_MAX_DELEGATION_DEPTH=1
CAMPUS_EXPLORATION_SHARE_PCT=20

# WordPress (Campus Core plugin REST). Unset = unconnected.
# CAMPUS_WP_BASE_URL=https://staging.example.org
# CAMPUS_WP_USER=campus-worker
# CAMPUS_WP_APP_PASSWORD=

# Ads: only honoured when CAMPUS_ENV=production AND a valid publisher id exists AND account approved.
CAMPUS_ADS_ENABLED=false
# CAMPUS_ADSENSE_PUBLISHER_ID=pub-0000000000000000

# Analytics / publishing switches
CAMPUS_ANALYTICS_ENABLED=false
CAMPUS_AUTO_PUBLISH_ENABLED=false

# Search Console (unconnected until property verified)
# CAMPUS_GSC_CREDENTIALS_PATH=/secrets/gsc.json
# CAMPUS_GSC_PROPERTY=https://example.org/
