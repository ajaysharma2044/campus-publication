{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "reader-test",
  "type": "object",
  "required": [
    "slug",
    "questions",
    "acts_on_top_layers",
    "confusions",
    "next_search"
  ],
  "properties": {
    "slug": {
      "type": "string",
      "minLength": 1
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "question",
          "answer",
          "found_in",
          "friction"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "answer": {
            "type": "string",
            "minLength": 1
          },
          "found_in": {
            "enum": [
              "takeaways",
              "opening",
              "heading",
              "section-top",
              "deep-in-section",
              "not-found"
            ]
          },
          "friction": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 0
          }
        }
      },
      "minItems": 1
    },
    "acts_on_top_layers": {
      "type": "object",
      "required": [
        "yes",
        "missing"
      ],
      "properties": {
        "yes": {
          "type": "boolean"
        },
        "missing": {
          "type": "string"
        }
      }
    },
    "confusions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 0
    },
    "next_search": {
      "type": "object",
      "required": [
        "query",
        "offered"
      ],
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1
        },
        "offered": {
          "type": "boolean"
        }
      }
    }
  }
}