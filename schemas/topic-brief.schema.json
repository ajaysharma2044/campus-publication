{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "topic-brief",
  "type": "object",
  "required": [
    "topic",
    "slug",
    "serves",
    "scope_in",
    "scope_out",
    "seed_questions",
    "start_sources",
    "competitors",
    "scores",
    "decision"
  ],
  "properties": {
    "topic": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "serves": {
      "type": "string",
      "minLength": 1
    },
    "scope_in": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "scope_out": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "item",
          "owner"
        ],
        "properties": {
          "item": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 0
    },
    "seed_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "text",
          "signal"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "signal": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 20
    },
    "start_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "url",
          "type"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "official",
              "dataset",
              "statute",
              "reporting",
              "commercial"
            ]
          }
        }
      },
      "minItems": 1
    },
    "competitors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "url",
          "misses"
        ],
        "properties": {
          "url": {
            "type": "string",
            "minLength": 1
          },
          "misses": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 0
    },
    "scores": {
      "type": "object",
      "required": [
        "demand",
        "no_clear_authority",
        "data_available",
        "ad_value",
        "fit",
        "durability"
      ],
      "properties": {
        "demand": {
          "type": "object",
          "required": [
            "score",
            "evidence"
          ],
          "properties": {
            "score": {
              "type": "integer"
            },
            "evidence": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "no_clear_authority": {
          "type": "object",
          "required": [
            "score",
            "evidence"
          ],
          "properties": {
            "score": {
              "type": "integer"
            },
            "evidence": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "data_available": {
          "type": "object",
          "required": [
            "score",
            "evidence"
          ],
          "properties": {
            "score": {
              "type": "integer"
            },
            "evidence": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "ad_value": {
          "type": "object",
          "required": [
            "score",
            "evidence"
          ],
          "properties": {
            "score": {
              "type": "integer"
            },
            "evidence": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "fit": {
          "type": "object",
          "required": [
            "score",
            "evidence"
          ],
          "properties": {
            "score": {
              "type": "integer"
            },
            "evidence": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "durability": {
          "type": "object",
          "required": [
            "score",
            "evidence"
          ],
          "properties": {
            "score": {
              "type": "integer"
            },
            "evidence": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "time_pressure": {
      "type": "string"
    },
    "decision": {
      "enum": [
        "proceed",
        "reject"
      ]
    },
    "reason": {
      "type": "string"
    }
  }
}