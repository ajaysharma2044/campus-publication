{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "batch-output",
  "type": "object",
  "required": [
    "batch_id",
    "pages"
  ],
  "properties": {
    "batch_id": {
      "type": "string",
      "minLength": 1
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "slug"
        ],
        "properties": {
          "slug": {
            "type": "string",
            "minLength": 1
          },
          "verdict": {
            "type": "string"
          },
          "meaning": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "reader_notes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "reader",
                "text"
              ],
              "properties": {
                "reader": {
                  "type": "string",
                  "minLength": 1
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "minItems": 0
          },
          "skip": {
            "type": "boolean"
          },
          "reason": {
            "type": "string"
          }
        }
      },
      "minItems": 1
    }
  }
}