{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "coverage-map",
  "type": "object",
  "required": [
    "slug",
    "topic",
    "page_type",
    "length_tier",
    "primary_query",
    "use_case",
    "answer_first",
    "sub_questions",
    "reader_blocks",
    "leave_to_siblings"
  ],
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "topic": {
      "type": "string",
      "minLength": 1
    },
    "page_type": {
      "enum": [
        "how-to",
        "decision",
        "cost",
        "checklist",
        "explainer",
        "roundup",
        "data-page"
      ]
    },
    "length_tier": {
      "enum": [
        "quick",
        "guide",
        "pillar"
      ]
    },
    "primary_query": {
      "type": "string",
      "minLength": 1
    },
    "use_case": {
      "type": "string",
      "minLength": 1
    },
    "answer_first": {
      "type": "string",
      "minLength": 1
    },
    "sub_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "question",
          "fact_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "fact_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "note": {
            "type": "string"
          },
          "section": {
            "type": "string"
          }
        }
      },
      "minItems": 1
    },
    "reader_blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "reader",
          "covers",
          "fact_ids"
        ],
        "properties": {
          "reader": {
            "type": "string",
            "minLength": 1
          },
          "covers": {
            "type": "string",
            "minLength": 1
          },
          "fact_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          }
        }
      },
      "minItems": 0
    },
    "leave_to_siblings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "question",
          "slug"
        ],
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1
          },
          "slug": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 0
    }
  }
}