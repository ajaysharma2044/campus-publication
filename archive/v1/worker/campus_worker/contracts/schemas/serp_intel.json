{
 "$id": "campus://contracts/serp_intel",
 "title": "Search intelligence output (continuous-local-run R13, R20, R36) \u2014 single cluster, or {batch: [...]} for up to 25 clusters (R27, R41)",
 "$defs": {
  "single": {
   "type": "object",
   "additionalProperties": true,
   "required": [
    "cluster_id",
    "observed_on",
    "label",
    "variants",
    "seasonality_notes",
    "demand_evidence",
    "search_calls_made"
   ],
   "properties": {
    "cluster_id": {
     "type": "string",
     "minLength": 1
    },
    "observed_on": {
     "type": "string",
     "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "label": {
     "type": "string",
     "pattern": "^observed via search tool on \\d{4}-\\d{2}-\\d{2}$"
    },
    "variants": {
     "type": "array",
     "minItems": 1,
     "maxItems": 4,
     "items": {
      "type": "object",
      "required": [
       "query",
       "results"
      ],
      "additionalProperties": true,
      "properties": {
       "query": {
        "type": "string",
        "minLength": 3
       },
       "results": {
        "type": "array",
        "maxItems": 10,
        "items": {
         "type": "object",
         "required": [
          "position",
          "url",
          "result_type",
          "dedicated",
          "answer_quality",
          "freshness",
          "evidence_quality"
         ],
         "additionalProperties": true,
         "properties": {
          "position": {
           "type": "integer",
           "minimum": 1,
           "maximum": 10
          },
          "url": {
           "type": "string",
           "minLength": 8
          },
          "title": {
           "type": [
            "string",
            "null"
           ]
          },
          "publisher": {
           "type": [
            "string",
            "null"
           ]
          },
          "result_type": {
           "type": "string",
           "enum": [
            "official",
            "aggregator",
            "forum",
            "news",
            "other"
           ]
          },
          "dedicated": {
           "type": "boolean"
          },
          "answer_quality": {
           "type": "string",
           "enum": [
            "complete",
            "partial",
            "none",
            "navigational_official"
           ]
          },
          "freshness": {
           "type": "string",
           "enum": [
            "current",
            "stale",
            "unknown"
           ]
          },
          "freshness_date": {
           "type": [
            "string",
            "null"
           ]
          },
          "academic_year_stated": {
           "type": [
            "string",
            "null"
           ]
          },
          "evidence_quality": {
           "type": "string",
           "enum": [
            "sourced",
            "unsourced",
            "unknown"
           ]
          },
          "missing_contribution": {
           "type": [
            "string",
            "null"
           ],
           "maxLength": 400
          }
         }
        }
       },
       "follow_up_questions": {
        "type": "array",
        "items": {
         "type": "string",
         "maxLength": 300
        }
       },
       "community_occurrences": {
        "type": "array",
        "items": {
         "type": "object",
         "required": [
          "url",
          "title",
          "site"
         ],
         "additionalProperties": true,
         "properties": {
          "url": {
           "type": "string"
          },
          "title": {
           "type": "string",
           "maxLength": 300
          },
          "site": {
           "type": "string"
          },
          "date": {
           "type": [
            "string",
            "null"
           ]
          },
          "snippet": {
           "type": [
            "string",
            "null"
           ],
           "maxLength": 400
          }
         }
        }
       },
       "navigational": {
        "type": "boolean"
       }
      }
     }
    },
    "seasonality_notes": {
     "type": "string",
     "maxLength": 600
    },
    "demand_evidence": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "kind",
       "query",
       "ref"
      ],
      "additionalProperties": true,
      "properties": {
       "kind": {
        "type": "string",
        "enum": [
         "related_question",
         "forum_thread",
         "official_faq",
         "keyword_export",
         "search_console"
        ]
       },
       "query": {
        "type": "string"
       },
       "ref": {
        "type": "string"
       },
       "independent": {
        "type": "boolean"
       }
      }
     }
    },
    "search_calls_made": {
     "type": "integer",
     "minimum": 0
    },
    "cache_hits": {
     "type": "integer",
     "minimum": 0
    }
   }
  }
 },
 "oneOf": [
  {
   "$ref": "#/$defs/single"
  },
  {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "batch"
   ],
   "properties": {
    "batch": {
     "type": "array",
     "minItems": 1,
     "maxItems": 25,
     "items": {
      "$ref": "#/$defs/single"
     }
    },
    "search_calls_made": {
     "type": "integer",
     "minimum": 0
    },
    "cache_hits": {
     "type": "integer",
     "minimum": 0
    }
   }
  }
 ]
}