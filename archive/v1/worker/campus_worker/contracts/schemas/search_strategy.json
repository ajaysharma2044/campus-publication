   "refresh_cadence": {"type": "array", "items": {"type": "object", "required": ["page_path", "cadence_days", "reason"], "properties": {"page_path": {"type": "string"}, "cadence_days": {"type": "integer", "minimum": 1, "maximum": 400}, "reason": {"type": "string", "maxLength": 300}}}},
   "win_criteria": {"type": "array", "items": {"type": "object", "required": ["page_path", "queries", "check_after_days"], "properties": {"page_path": {"type": "string"}, "queries": {"type": "array", "items": {"type": "string"}}, "check_after_days": {"type": "integer", "minimum": 1}, "success": {"type": "string", "maxLength": 300}}}}
 }}
