     "properties": {"page_path": {"type": "string"}, "contribution": {"type": "string", "minLength": 20, "maxLength": 600},
                    "target_title": {"type": "string", "minLength": 10, "maxLength": 60}, "h1": {"type": "string", "minLength": 10},
                    "answer_first_intro": {"type": "string", "minLength": 20, "maxLength": 400},
                    "snippet_formats": {"type": "array", "items": {"type": "string", "enum": ["table", "numbered_steps", "definition_sentence", "comparison_table", "none"]}},
                    "faq_real_questions": {"type": "array", "items": {"type": "string"}},
                    "secondary_questions": {"type": "array", "items": {"type": "string"}},
                    "beats": {"type": "array", "items": {"type": "object", "required": ["url", "how"], "properties": {"url": {"type": "string"}, "how": {"type": "string", "maxLength": 300}}}}}}},
   "internal_links": {"type": "array", "items": {"type": "object", "required": ["from", "to", "anchor_text"], "properties": {"from": {"type": "string"}, "to": {"type": "string"}, "anchor_text": {"type": "string", "minLength": 3, "maxLength": 120}}}},
   "trust_signals": {"type": "object", "required": ["sources_section", "methods_link", "updated_date", "corrections_link"],
