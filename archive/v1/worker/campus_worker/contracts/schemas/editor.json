{
 "$id": "campus://contracts/editor",
 "type": "object",
 "additionalProperties": false,
 "properties": {
  "revised_headline": {
   "type": "string",
   "minLength": 15,
   "maxLength": 110
  },
  "revised_deck": {
   "type": [
    "string",
    "null"
   ],
   "maxLength": 300
  },
  "revised_body_markdown": {
   "type": "string",
   "minLength": 200,
   "maxLength": 40000
  },
  "findings": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "kind",
     "detail"
    ],
    "properties": {
     "kind": {
      "type": "string",
      "enum": [
       "clarity",
       "specificity",
       "structure",
       "attribution",
       "usefulness",
       "prose",
       "filler",
       "unsupported",
       "duplicate",
       "headline"
      ]
     },
     "detail": {
      "type": "string",
      "maxLength": 500
     },
     "resolved": {
      "type": "boolean"
     }
    }
   }
  },
  "substantive_changes": {
   "type": "array",
   "items": {
    "type": "string",
    "maxLength": 300
   }
  },
  "unresolved": {
   "type": "array",
   "items": {
    "type": "string",
    "maxLength": 300
   }
  },
  "beat_review": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "ours",
    "competitors"
   ],
   "properties": {
    "ours": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "answers_first_two_sentences",
      "specificity",
      "completeness",
      "accuracy_against_sources",
      "scannability",
      "local_knowledge"
     ],
     "properties": {
      "answers_first_two_sentences": {
       "type": "integer",
       "minimum": 0,
       "maximum": 4
      },
      "specificity": {
       "type": "integer",
       "minimum": 0,
       "maximum": 4
      },
      "completeness": {
       "type": "integer",
       "minimum": 0,
       "maximum": 4
      },
      "accuracy_against_sources": {
       "type": "integer",
       "minimum": 0,
       "maximum": 4
      },
      "scannability": {
       "type": "integer",
       "minimum": 0,
       "maximum": 4
      },
      "local_knowledge": {
       "type": "integer",
       "minimum": 0,
       "maximum": 4
      }
     }
    },
    "competitors": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "url",
       "scores"
      ],
      "properties": {
       "url": {
        "type": "string"
       },
       "scores": {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "answers_first_two_sentences",
         "specificity",
         "completeness",
         "accuracy_against_sources",
         "scannability",
         "local_knowledge"
        ],
        "properties": {
         "answers_first_two_sentences": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
         },
         "specificity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
         },
         "completeness": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
         },
         "accuracy_against_sources": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
         },
         "scannability": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
         },
         "local_knowledge": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
         }
        }
       },
       "note": {
        "type": "string",
        "maxLength": 400
       }
      }
     }
    },
    "verdict_note": {
     "type": "string",
     "maxLength": 600
    }
   }
  }
 },
 "if": {
  "required": [
   "beat_review"
  ]
 },
 "then": {
  "required": [
   "beat_review",
   "findings"
  ]
 },
 "else": {
  "required": [
   "revised_body_markdown",
   "revised_headline",
   "findings",
   "substantive_changes"
  ]
 }
}
