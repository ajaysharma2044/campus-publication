{
  "name": "footnote-daily-site",
  "private": true,
  "type": "module",
  "description": "Footnote Daily site templates: the Astro build (parallel to scripts/v2/render_site.py).",
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/sync-images.mjs",
    "build": "astro build && node scripts/check-build.mjs",
    "postbuild": "pagefind --site dist",
    "preview": "astro preview",
    "check": "node scripts/check-build.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "lighthouse": "node scripts/lighthouse.mjs"
  },
  "dependencies": {
    "astro": "5.18.2",
    "hast-util-to-html": "^9.0.6",
    "hast-util-to-string": "3.0.1",
    "js-yaml": "4.1.0",
    "mdast-util-to-string": "4.0.0",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sharp": "0.35.5",
    "unified": "^11.0.5",
    "unist-util-visit": "5.0.0"
  },
  "devDependencies": {
    "lighthouse": "13.6.0",
    "pagefind": "1.6.0"
  }
}
