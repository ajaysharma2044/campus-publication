---
import { getSite, type Page } from '../../../lib/model';
import PillarLayout from '../../../layouts/PillarLayout.astro';
import AnswerLayout from '../../../layouts/AnswerLayout.astro';
import PlaceLayout from '../../../layouts/PlaceLayout.astro';
import ComparisonLayout from '../../../layouts/ComparisonLayout.astro';
export async function getStaticPaths() {
  const m = await getSite();
  return m.pages.filter((p) => !p.crossSchool && p.pageType !== 'data').map((p) => ({ params: { school: p.school.slug, topic: p.topic.id, slug: p.slug }, props: { page: p } }));
}
const { page } = Astro.props as { page: Page };
const m = await getSite();
---
{page.pageType === 'pillar' ? <PillarLayout m={m} page={page} /> : page.pageType === 'answer' ? <AnswerLayout m={m} page={page} /> : page.pageType === 'place' ? <PlaceLayout m={m} page={page} /> : <ComparisonLayout m={m} page={page} />}
