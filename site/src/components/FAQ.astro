---
import type { FaqItem } from '../lib/markdown';
interface Props { items: FaqItem[]; title?: string }
const { items, title = 'Frequently asked questions' } = Astro.props;
---
{items.length ? (
  <section class="faq" aria-labelledby="faq-title">
    <h2 id="faq-title">{title}</h2>
    {items.map((f) => <div class="faq__item"><h3 class="faq__q">{f.q}</h3><div class="faq__a" set:html={f.a} /></div>)}
  </section>
) : null}
