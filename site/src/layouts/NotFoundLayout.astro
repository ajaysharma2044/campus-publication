---
/* Template 14: the 404 page. Astro emits dist/404.html, which Netlify serves with a real 404 status. */
import Base from './Base.astro';
import { site } from '../../site.config';
import type { SiteModel } from '../lib/model';
import { schoolUrl, topicUrl } from '../lib/model';
import SearchBox from '../components/SearchBox.astro';
interface Props { m: SiteModel }
const { m } = Astro.props;
const hubs = site.schools.slice(0, 5);
const topics = site.topics.slice(0, 5);
---
<Base title="Page not found" description="We couldn't find that page." path="/404/" noindex>
  <div class="page--single notfound">
    <div class="main">
      <header class="head"><p class="kicker">Error 404</p><h1>We couldn't find that page</h1><p class="dek">The address may have changed when a guide was updated, or it was never here. Search for what you need, or start from a school hub.</p></header>
      <SearchBox />
      <section class="section" aria-labelledby="nf-schools">
        <div class="section__head"><h2 id="nf-schools">School hubs</h2></div>
        <ul class="glist">
          <li class="glist__item"><h3 class="glist__title"><a href="/">Footnote Daily homepage</a></h3></li>
          {hubs.map((s) => <li class="glist__item"><h3 class="glist__title"><a href={schoolUrl(s)}>{s.short} Student Guide</a></h3><p class="glist__dek">{topics.map((t, i) => <Fragment>{i ? ' · ' : ''}<a href={topicUrl(s, t)}>{t.label}</a></Fragment>)}</p></li>)}
        </ul>
      </section>
    </div>
  </div>
</Base>
