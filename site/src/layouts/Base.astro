---
/* The shell every template shares: head (title, description, canonical, Open Graph, JSON-LD, font preloads), skip link,
   Masthead, SchoolSubnav (school pages only), main landmark, Footer, mobile anchor ad. */
import '../styles/global.css';
import { site, type School } from '../../site.config';
import { graph, organization, webSite } from '../lib/schema';
import Masthead from '../components/Masthead.astro';
import SchoolSubnav from '../components/SchoolSubnav.astro';
import Footer from '../components/Footer.astro';
import AdSlot from '../components/AdSlot.astro';
interface Props { title: string; description: string; path: string; ogImage?: string; ogType?: string; noindex?: boolean; index?: boolean; searchable?: boolean; school?: School | null; current?: string; jsonld?: object[]; bodyClass?: string; preloadImage?: string; preloadSrcset?: string; preloadSizes?: string; preloadType?: string }
const { title, description, path, ogImage = '/og-default.png', ogType = 'website', noindex = false, index = true, searchable = !noindex, school = null, current, jsonld = [], bodyClass, preloadImage, preloadSrcset, preloadSizes = '(min-width: 980px) 720px, 100vw', preloadType = 'image/avif' } = Astro.props;
const canonical = new URL(path, site.url).toString();
// docs/v5 Phase 9a: nothing is indexed until the site is launched. After launch, articles, tools, datasets and start pages pass their frontmatter index field (false unless promoted); the homepage, hubs, indexes and trust pages pass nothing and default to indexed; noindex always wins. Everything else is noindex, follow (links are followed once crawlable)
const robots = site.launched && index && !noindex ? 'index, follow, max-image-preview:large' : 'noindex, follow';
const fullTitle = title.includes(site.name) ? title : `${title} | ${site.name}`;
const ld = graph([organization(), webSite(), ...jsonld]);
const anchor = site.ads.provider !== 'none';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="robots" content={robots} />
  <meta name="theme-color" content="#0E1B33" />
  <meta property="og:site_name" content={site.name} />
  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL(ogImage, site.url).toString()} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <link rel="preload" href="/fonts/Newsreader-Variable.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/LibreFranklin-Variable.woff2" as="font" type="font/woff2" crossorigin />
  {preloadSrcset ? <link rel="preload" as="image" imagesrcset={preloadSrcset} imagesizes={preloadSizes} type={preloadType} fetchpriority="high" /> : preloadImage ? <link rel="preload" as="image" href={preloadImage} fetchpriority="high" /> : null}
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <script src="/site.js" defer></script>
  {site.ads.adsenseClient && !import.meta.env.DEV ? <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${site.ads.adsenseClient}`} crossorigin="anonymous"></script> : null}
</head>
<body class:list={[bodyClass, { 'body-has-anchor': anchor }]}>
  <a class="skip" href="#main">Skip to content</a>
  <Masthead />
  {school ? <SchoolSubnav school={school} current={current} /> : null}
  <main id="main" class="wrap page" tabindex="-1" data-pagefind-body={searchable ? "" : undefined}>
    <slot />
  </main>
  <Footer />
  {anchor ? <AdSlot size="320x50" position="anchor" device="mobile" lazy={false} /> : null}
</body>
</html>
